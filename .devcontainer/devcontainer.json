{
  "name": "MoonScout Lunar Prospector",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt ipykernel nbformat",
  "forwardPorts": [8503],
  "portsAttributes": {
    "8503": {
      "label": "MoonScout Streamlit",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  }
}
